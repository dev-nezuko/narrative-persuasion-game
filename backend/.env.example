# "fake" runs the game offline with a deterministic stand-in for the models.
# Set to "venice" and fill VENICE_API_KEY only when deliberately testing generation.
DOORMAN_PROVIDER=fake
VENICE_API_KEY=

# Optional private session directory and idle-session lifetime:
# DOORMAN_SESSION_DIR=/absolute/path/to/local/sessions
# DOORMAN_SESSION_TTL_HOURS=24

# Abuse limits (defaults shown):
# DOORMAN_TURNS_PER_MINUTE=8
# DOORMAN_MAX_TURNS_PER_SESSION=60
# DOORMAN_NEW_SESSIONS_PER_MINUTE=30

# Comma-separated browser origins allowed by CORS:
# DOORMAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
